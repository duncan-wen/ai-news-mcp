#!/usr/bin/env bash
# Runs every automated check: lint, format, types, tests and the package build.
# CI runs this same script.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run ruff check .
uv run ruff format --check .
uv run pyright
# CI also runs on macOS and Windows; these catch platform-only APIs (time.tzset) before a push.
uv run pyright --pythonplatform Darwin
uv run pyright --pythonplatform Windows
# Makes a text read or write without encoding= fail (pyproject's filterwarnings): Windows'
# default code page cannot read README.zh-TW.md or GLOSSARY.md.
PYTHONWARNDEFAULTENCODING=1 uv run pytest

# Builds the sdist, then the wheel from it, as a release does: `uv run`'s editable
# install skips that path (a file left out of the sdist fails only here).
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
uv build --quiet --out-dir "$build_dir"
